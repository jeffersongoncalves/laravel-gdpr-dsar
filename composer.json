{
    "name": "jeffersongoncalves/laravel-gdpr-dsar",
    "description": "GDPR data subject requests for Laravel: access, rectification, erasure, restriction, portability, objection (Arts. 15-22), identity check, one-month deadline with extension (Art. 12(3)), automatic export and erasure.",
    "keywords": [
        "laravel",
        "gdpr",
        "dsar",
        "data-subject-rights",
        "right-to-erasure",
        "data-portability",
        "privacy"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-gdpr-dsar",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Simão Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\GdprDsar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\GdprDsar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\GdprDsar\\GdprDsarServiceProvider"
            ],
            "aliases": {
                "GdprDsar": "JeffersonGoncalves\\GdprDsar\\Facades\\GdprDsar"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
